# Plantilla de configuración. Solo nombres y ejemplos: NINGÚN valor real.
# Los archivos ".env" y ".env.*" NO se suben a GitHub (están en .gitignore);
# este ".env.example" sí.
#
# Hay dos archivos privados, ambos en esta misma carpeta:
#   .env             -> correo (docker-compose lo lee para EMAIL_*).
#   .env.desarrollo  -> secretos de desarrollo (docker-compose lo entrega a los
#                       contenedores con env_file). Sin él, Django no arranca.

# ===== .env =================================================================
# Envío real de correo (códigos OTP, bienvenida, recuperación de contraseña).
# Si EMAIL_HOST_USER queda vacío, los correos NO se envían: se imprimen en
# los logs ("docker compose logs web"), útil SOLO para desarrollo. En
# producción (sin DEBUG) son obligatorios: Django no arranca sin ellos.
#
# Gmail: EMAIL_HOST_PASSWORD es una "contraseña de aplicación" de 16 letras,
# NO la contraseña normal de la cuenta. Se genera en
# https://myaccount.google.com/apppasswords (requiere verificación en 2 pasos).
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# ===== .env.desarrollo (Fase 40S-1) =========================================
# Copia estas cuatro líneas a ".env.desarrollo" y reemplaza los ejemplos.
# Para seguir usando una base local ya creada, deben ser los MISMOS valores que
# esa base usaba (si cambias RUT_HASH_PEPPER, las cuentas no pueden entrar con
# su RUT; si cambias SECRET_KEY, se cierran las sesiones). Pídelos a la
# responsable del proyecto por un canal privado; no los envíes por chat ni correo.
# Usa comillas simples: Docker Compose toma el valor literalmente.
#
# SECRET_KEY='ejemplo-no-usar-genera-uno-propio'
# RUT_HASH_PEPPER='ejemplo-no-usar'
# DB_PASSWORD='ejemplo-no-usar'
# POSTGRES_PASSWORD='ejemplo-no-usar'          # igual a DB_PASSWORD
#
# Para generar valores nuevos (solo para una base nueva o en producción):
#   python -c "import secrets; print(secrets.token_urlsafe(50))"

# ===== Producción (variables del servidor, nunca en un archivo del repositorio)
# DEBUG=0                        # o sin definir: DEBUG está desactivado por defecto
# SECRET_KEY=...                 # mínimo 50 caracteres, distinto al de desarrollo
# RUT_HASH_PEPPER=...            # mínimo 32 caracteres; respaldarlo cifrado (ver 40S-2)
# DB_NAME=... DB_USER=... DB_PASSWORD=... DB_HOST=... DB_PORT=5432
# ALLOWED_HOSTS=ejemplo.cl,www.ejemplo.cl
# CSRF_TRUSTED_ORIGINS=https://ejemplo.cl,https://www.ejemplo.cl
# EMAIL_HOST_USER=... EMAIL_HOST_PASSWORD=...
# Solo cuando se confirme el despliegue con HTTPS (Fase 18):
# SECURE_SSL_REDIRECT=1
# DETRAS_DE_PROXY_HTTPS=1        # solo si un proxy fija X-Forwarded-Proto
# SECURE_HSTS_SECONDS=3600       # empezar con un valor corto

# Fase 40D — Orientaciones educativas (apagadas por defecto).
# El catálogo actual es un BORRADOR no validado clínicamente. PERMITIR_BORRADOR=1
# solo para pruebas con datos sintéticos; NUNCA con participantes reales.
# ORIENTACIONES_HABILITADAS=0
# ORIENTACIONES_PERMITIR_BORRADOR=0

# Fase 40, Etapa 2 — Cierre de sesión por inactividad (segundos). Por defecto 30 min y aviso 2 min antes.
# SESION_INACTIVIDAD_SEGUNDOS=1800
# SESION_AVISO_SEGUNDOS=120
